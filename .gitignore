# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg

# Tool caches
.pytest_cache/
.ruff_cache/

# Local env / secrets: never commit API keys
.env
.env.*
!.env.example

# Claude Code per-user overrides (the shared .claude/settings.json is committed)
.claude/settings.local.json

# Eval / run output
logs/

# Agent artefacts: analysis source is tracked, its outputs never are. The results of a scan
# are reproducible from the source plus the logs, and are large and numerous; the scanners,
# rubric implementations and analysis scripts are the work.
agent_artefacts/*
!agent_artefacts/trajectory_analysis/
agent_artefacts/trajectory_analysis/*
!agent_artefacts/trajectory_analysis/inspect_scout/
agent_artefacts/trajectory_analysis/inspect_scout/scout_results/
agent_artefacts/trajectory_analysis/inspect_scout/logs/
agent_artefacts/trajectory_analysis/inspect_scout/__pycache__/
!agent_artefacts/trajectory_analysis/cot_redhanded/
agent_artefacts/trajectory_analysis/cot_redhanded/scout_results/
agent_artefacts/trajectory_analysis/cot_redhanded/rubric_results/
agent_artefacts/trajectory_analysis/cot_redhanded/__pycache__/

# Run and analysis scripts referenced by research/experiment_results_log.md, which must exist in
# repo for those entries to be checkable. Their logs and outputs stay ignored.
!agent_artefacts/cot_redhanded/
agent_artefacts/cot_redhanded/*
!agent_artefacts/cot_redhanded/baseline/
agent_artefacts/cot_redhanded/baseline/*.log
agent_artefacts/cot_redhanded/baseline/__pycache__/
!agent_artefacts/cot_redhanded/parity/
agent_artefacts/cot_redhanded/parity/__pycache__/

# Editors
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Upstream cot_red_handed writes this cross-run cache into the working directory
completed_ids/
# Caches moved aside before a re-run, so `retry_solver` cannot short-circuit samples to
# CORRECT with no model call and no transcript (B-6 in research/audit_issues.md).
completed_ids_quarantine/

# Inspect Scout writes here when run without an explicit -o
scout_results/
